{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./public",
    "allowJs": true,
    "module": "es6",
    "target": "es2016",
    "lib": ["ES2018", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}
